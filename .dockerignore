# Secrets and local data must never reach the image. backend/.env holds the
# Azure SQL connection string; config.py's load_dotenv() would read it.
**/.env
**/.env.*
# FLASK_DEBUG=1 for local `flask run`; the Dockerfile sets FLASK_APP itself.
backend/.flaskenv
backend/instance
**/*.db
**/*.db-journal

# Rebuilt inside the image
**/node_modules
frontend/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache

# Not needed to build or run
.git
.playwright-mcp
notes
docs
brand
*.docx
*.pdf
